# Copy this file to functions/.env.<firebase-project-id> (for example .env.speshio) and fill in the values.
# Firebase loads only the file matching the project it deploys to, so the project id in the name matters.
# Secrets (service role key, webhook secret, B2 keys, Brevo API key) belong in Google Secret Manager, not here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
B2_ENDPOINT=https://s3.YOUR_REGION.backblazeb2.com
B2_REGION=YOUR_REGION
B2_BUCKET_NAME=YOUR_BUCKET
B2_PUBLIC_URL=
BREVO_SENDER_EMAIL=billing-test@yourplatform.com
BREVO_SENDER_NAME=Books
